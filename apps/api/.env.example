NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=mysql://app:app_dev@localhost:3308/hr_fam_dev
APP_ORIGIN=http://localhost:3000
RATE_LIMIT_STORE=database
# Read-only external databases (docs/platform/data-sources.md):
# HRM (bcel_hrm_v3): a SELECT-only user on testing and production. Locally, a copy loaded from
# test/sources/hrm.schema.sql and hrm.fixtures.sql (docs/hrm-handoff.md, "Local copy").
DATA_SOURCES=hrm
DATA_SOURCE_HRM_URL=mysql://app:app_dev@localhost:3308/hr_fam_src_hrm
DATA_SOURCE_HRM_TIMEZONE=+07:00
# HRM login page: visits without a session and failed handoffs go here (?error=<code>).
HRM_LOGIN_URL=http://localhost:3000/auth/sign-in?local=1
# HRM's origin: when set, only handoffs whose Referer comes from it are accepted (set it on testing/production).
# HRM_ORIGIN=https://hrm.example
# Behind a reverse proxy, list it so sign-in rate limits use the client address (docs/platform/deployment.md).
# TRUSTED_PROXIES=10.0.0.1
# HRM sessions end after 4 hours idle (ຂ6); the app matches it.
AUTH_SESSION_IDLE_MINUTES=240
MAIL_TRANSPORT=console
MAIL_FROM=HR-FAM <no-reply@localhost>
BODY_LIMIT_KB=11264
# Where uploads are stored: local | shared | s3
FILES_STORAGE=local
FILES_DIR=storage/files
# FILES_DIR=/mnt/nas/app-files
